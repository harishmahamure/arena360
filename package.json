{
  "name": "gaming-cafe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/admin",
    "apps/kiosk",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "gen:api-types": "tsx scripts/gen-api-types.ts",
    "gen:proto": "buf generate",
    "lint:proto": "buf lint",
    "gen:bruno": "tsx scripts/gen-bruno-collection.ts",
    "migration": "tsx scripts/migration.ts",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepare": "simple-git-hooks",
    "admin:dev": "pnpm --filter @gaming-cafe/admin dev",
    "admin:build": "pnpm --filter @gaming-cafe/admin build",
    "backend:build": "cargo build --manifest-path apps/backend/Cargo.toml",
    "backend:build:release": "cargo build --release --manifest-path apps/backend/Cargo.toml",
    "backend:dev": "cargo run --manifest-path apps/backend/Cargo.toml",
    "backend:run": "cargo run --manifest-path apps/backend/Cargo.toml",
    "backend:test": "cargo test --manifest-path apps/backend/Cargo.toml",
    "backend:test:integration": "node apps/backend/scripts/test-integration.mjs",
    "analytics:stream:init": "cargo run --manifest-path apps/backend/Cargo.toml --bin tenant_events_setup",
    "backend:clippy": "cargo clippy --all-targets --manifest-path apps/backend/Cargo.toml -- -D warnings",
    "backend:fmt": "cargo fmt --manifest-path apps/backend/Cargo.toml",
    "kiosk:dev": "pnpm --filter @gaming-cafe/kiosk tauri:dev",
    "kiosk:build": "pnpm --filter @gaming-cafe/kiosk tauri:build",
    "demo:seed": "node apps/backend/scripts/seed-demo.mjs",
    "demo:test": "node --test apps/backend/scripts/seed-demo.test.mjs",
    "report:fixtures": "node apps/backend/scripts/capture-report-fixtures.mjs",
    "bench:venue-day": "node apps/backend/scripts/bench-venue-day.mjs",
    "bench:cell-capacity": "node apps/backend/scripts/bench-cell-capacity.mjs",
    "bench:test": "node --test apps/backend/scripts/bench-cell-capacity.test.mjs",
    "portal:dev": "pnpm --filter @gaming-cafe/admin exec vite --port 5174 --open /portal.html",
    "portal:build": "pnpm --filter @gaming-cafe/admin build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.27.10",
    "@gaming-cafe/biome-config": "workspace:*",
    "@gaming-cafe/tsconfig": "workspace:*",
    "@types/node": "^20.17.10",
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "pg": "^8.21.0",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.11.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "~5.6.3"
  },
  "simple-git-hooks": {
    "pre-commit": "bash scripts/pre-commit-biome.sh"
  }
}
