{
  "name": "gaming-cafe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/admin",
    "apps/tenant",
    "apps/kiosk",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "gen:api-types": "tsx scripts/gen-api-types.ts",
    "gen:proto": "buf generate && biome check --write packages/proto/src/gen",
    "lint:proto": "buf lint",
    "gen:bruno": "tsx scripts/gen-bruno-collection.ts",
    "migration": "tsx scripts/migration.ts",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepare": "simple-git-hooks",
    "admin:dev": "pnpm --filter @gaming-cafe/admin dev",
    "admin:build": "pnpm --filter @gaming-cafe/admin build",
    "services:build": "cargo build -p tenant-gateway -p tenant-storage",
    "storage:dev": "cargo run -p tenant-storage",
    "gateway:dev": "cargo run -p tenant-gateway",
    "services:check": "cargo check --workspace --all-targets",
    "backend:build": "cargo build -p gaming-cafe-api",
    "backend:build:release": "cargo build --release -p gaming-cafe-api",
    "backend:dev": "cargo run -p gaming-cafe-api",
    "backend:run": "cargo run -p gaming-cafe-api",
    "backend:test": "cargo test -p arena360-core -p arena360-tools",
    "backend:test:integration": "node tools/backend-cli/scripts/test-integration.mjs",
    "analytics:stream:init": "cargo run -p arena360-tools --bin tenant_events_setup",
    "backend:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "backend:fmt": "cargo fmt --all",
    "kiosk:dev": "pnpm --filter @gaming-cafe/kiosk tauri:dev",
    "kiosk:build": "pnpm --filter @gaming-cafe/kiosk tauri:build",
    "demo:seed": "node tools/backend-cli/scripts/seed-demo.mjs",
    "demo:test": "node --test tools/backend-cli/scripts/seed-demo.test.mjs",
    "report:fixtures": "node tools/backend-cli/scripts/capture-report-fixtures.mjs",
    "bench:venue-day": "node tools/backend-cli/scripts/bench-venue-day.mjs",
    "bench:cell-capacity": "node tools/backend-cli/scripts/bench-cell-capacity.mjs",
    "bench:test": "node --test tools/backend-cli/scripts/bench-cell-capacity.test.mjs",
    "portal:dev": "pnpm --filter @gaming-cafe/tenant dev",
    "portal:build": "pnpm --filter @gaming-cafe/tenant build",
    "rust:check": "cargo check --workspace --all-targets",
    "rust:test": "cargo test --workspace",
    "rust:fmt": "cargo fmt --all",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "tools:build": "cargo build -p arena360-tools",
    "rust:image": "node tools/backend-cli/scripts/build-rust-image.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.27.10",
    "@gaming-cafe/biome-config": "workspace:*",
    "@gaming-cafe/tsconfig": "workspace:*",
    "@types/node": "^20.17.10",
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "pg": "^8.21.0",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.11.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "~5.6.3"
  },
  "simple-git-hooks": {
    "pre-commit": "bash scripts/pre-commit-biome.sh"
  }
}
