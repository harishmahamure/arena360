# Database
# Control-plane PostgreSQL for staff identity, routing and ownership leases.
CONTROL_DATABASE_URL=postgres://user:password@localhost:5432/arena360_control
# Required by cell processes that acquire tenant ownership leases.
ARENA_CELL_ID=
# Local root for per-tenant SQLite files.
TENANT_DATA_DIR=data/tenants
DATABASE_MAX_CONNECTIONS=10

# Demo seed: explicit control target override, existing active operator, optional player login.
# Defaults create login-disabled demo identities. Keep passwords out of committed files.
# DEMO_CONTROL_DATABASE_URL=postgres://user:password@localhost:5432/disposable_control
# DEMO_OWNER_USER_ID=
# DEMO_PLAYER_PASSWORD=

# Cache (optional — operational reads fall back to tenant SQLite)
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_SECRET=your-secret-key-must-be-at-least-32-characters-long

# Server
PORT=3000

# Timezone
CAFE_TZ=Asia/Kolkata

# ZeptoMail (OTP delivery)
ZEPTOMAIL_TOKEN=

# Object storage for game media assets (DRAFT-0022).
# S3-compatible endpoint (AWS S3, Cloudflare R2, MinIO, etc.). Presigned PUT URLs
# are issued for direct browser uploads; only the URLs are stored in the DB.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
# Optional public base for stored URLs (defaults to {STORAGE_ENDPOINT}/{STORAGE_BUCKET}).
STORAGE_PUBLIC_URL=
# Presigned URL lifetime in seconds (default 900).
STORAGE_PRESIGN_EXPIRY_SECS=900

# Tenant analytics is rebuilt from the SQLite outbox in M6; reports are unavailable until M7.
NATS_URL=nats://127.0.0.1:4222
# Run pnpm analytics:stream:init before publishing; use 3/5 only on a NATS cluster.
NATS_STREAM_REPLICAS=1
NATS_ANALYTICS_REPLICAS=1
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=arena360
CLICKHOUSE_USER=arena360
CLICKHOUSE_PASSWORD=arena360
